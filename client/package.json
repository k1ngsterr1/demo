{
  "name": "statement-import-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=20.19.4 <21 || >=22"
  },
  "scripts": {
    "postinstall": "node scripts/patch-toolchain.mjs",
    "start": "node scripts/patch-toolchain.mjs && expo start --dev-client --localhost",
    "ios": "node scripts/patch-toolchain.mjs && expo run:ios",
    "android": "node scripts/patch-toolchain.mjs && expo run:android",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run check:architecture && npm run check:toolchain && npm run typecheck && npm test",
    "check:toolchain": "node --test scripts/toolchain.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write App.tsx \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check App.tsx \"src/**/*.{ts,tsx}\"",
    "prebuild": "node scripts/patch-toolchain.mjs && expo prebuild"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "55.0.32",
    "expo-build-properties": "55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-splash-screen": "~55.0.25",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^55.0.25",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "@expo/config": {
      "deepmerge": "npm:@fastify/deepmerge@3.2.4"
    },
    "@react-native/dev-middleware": {
      "chromium-edge-launcher": "0.3.0"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "7.0.2"
    },
    "glob@7": "14.0.2",
    "glob@10": "14.0.2",
    "glob@13": "14.0.2",
    "minimatch@10": "11.0.1"
  },
  "type": "module"
}
